{
	"name": "quiz",
	"version": "0.1.10",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "NODE_OPTIONS='--max-old-space-size=450' next build && npm run build:standalone-assets",
		"build:standalone-assets": "mkdir -p .next/standalone/.next && cp -R public .next/standalone/public && cp -R .next/static .next/standalone/.next/static",
		"start": "NODE_OPTIONS='--max-old-space-size=450' next start",
		"start:standalone": "NODE_OPTIONS='--max-old-space-size=450' node .next/standalone/server.js",
		"lint": "eslint"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"next": "16.4.3",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@tailwindcss/turbopack": "^4",
		"@types/node": "^24.19.2",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "16.4.3",
		"tailwindcss": "^4",
		"typescript": "^5"
	}
}
